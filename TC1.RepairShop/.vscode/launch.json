{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/TC1.RepairShop.Api/bin/Debug/net10.0/TC1.RepairShop.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TC1.RepairShop.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": ".NET Launch Migrations",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-migrations",
            "program": "${workspaceFolder}/src/TC1.RepairShop.Migrations/bin/Debug/net10.0/TC1.RepairShop.Migrations.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/TC1.RepairShop.Migrations",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}