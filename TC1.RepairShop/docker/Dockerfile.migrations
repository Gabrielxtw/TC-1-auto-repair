FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/TC1.RepairShop.Migrations/TC1.RepairShop.Migrations.csproj src/TC1.RepairShop.Migrations/

RUN dotnet restore src/TC1.RepairShop.Migrations/TC1.RepairShop.Migrations.csproj

COPY src/TC1.RepairShop.Migrations/ src/TC1.RepairShop.Migrations/

RUN dotnet publish src/TC1.RepairShop.Migrations/TC1.RepairShop.Migrations.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "TC1.RepairShop.Migrations.dll"]
